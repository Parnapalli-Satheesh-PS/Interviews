from airflow import DAG
from airflow.operators.dummy import DummyOperator
from datetime import datetime

default_args = {
    'owner': 'airflow',
    'depends_on_past': False,
    'start_date': datetime(2025, 3, 20),
    'retries': 1,
}

dag_weekends_6pm = DAG(
    'dag_weekends_6pm',
    default_args=default_args,
    schedule_interval="0 18 * * 6,7",  # Runs at 6 PM UTC on Saturdays & Sundays
    catchup=False
)

task = DummyOperator(task_id='start', dag=dag_weekends_6pm)
