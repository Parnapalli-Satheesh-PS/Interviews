how to find the duplicates 
select ID, name, Salary, count(*) from employees
group by 1,2,3
having count(*) > 1;

SELECT ID, COUNT(*) FROM employees
GROUP BY ID
HAVING COUNT(*) > 1;

how to delete duplicate records

with CTE AS(
select id, name,
ROW_NUMBER() over (partition by name order by salary desc) as DuplicateCount
from employee)
delete from employee where id IN
(select id from CTE where DuplicateCount > 1);


