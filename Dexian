Find the Raising temperature from previous day and print out the days where there is raise.
   Weather table:
   +----+------------+-------------+
   | id | recordDate | temperature |
   +----+------------+-------------+
   | 1  | 2015-01-01 | 10          |
   | 2  | 2015-01-02 | 25          |
   | 3  | 2015-01-03 | 20          |
   | 4  | 2015-01-04 | 30          |
   +----+------------+-------------+

   Output: 
   +----+
   | id |
   +----+
   | 2  |
   | 4  |

select id(
select id, recordDate, temperature,
lag(temperature) over (order by recordDate) as previous_temperature
from Weather
)
where temperature > previous_temperature;
